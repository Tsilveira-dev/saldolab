# Exemplo de configuração — não coloque credenciais reais neste arquivo.
# DATABASE_URL: conexão pooled da branch Neon utilizada pelas Vercel Functions.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/saldolab?sslmode=require
# DATABASE_URL_UNPOOLED: conexão direta para scripts de migração.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/saldolab?sslmode=require

# Neon Auth: os URLs públicos são específicos por branch, não segredos.
VITE_NEON_AUTH_URL=https://YOUR-NEON-AUTH-HOST/saldolab/auth
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST/saldolab/auth
NEON_AUTH_JWKS_URL=https://YOUR-NEON-AUTH-HOST/saldolab/auth/.well-known/jwks.json

# Configuração local. Não configurar o banco de produção em ambientes de teste.
# NEVER use the prefix VITE_ with any database connection string or private key.
